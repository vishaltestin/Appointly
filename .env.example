# ── Required ─────────────────────────────────────────────────────────────

# MySQL / MariaDB connection string.
DATABASE_URL="mysql://appointly:appointly_dev_pw@localhost:3306/appointly"

# Auth.js session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Canonical URL of the app, used by Auth.js for callbacks and redirects.
NEXTAUTH_URL="http://localhost:3000"

# Public base URL used to build booking and manage-booking links
# (sharable links, reminder emails, etc.).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Optional ─────────────────────────────────────────────────────────────

# Set to true when running behind a proxy or on a non-localhost host
# (Auth.js will trust forwarded host headers).
# AUTH_TRUST_HOST="true"

# Google OAuth. Leave blank and the "Continue with Google" button is hidden.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Bearer token required to call POST /api/cron/send-reminders.
# Required only if you schedule the reminder job.
# CRON_SECRET=""

# Credentials for the first super admin created by `npm run db:seed`.
# Change the password immediately after first login.
# SUPER_ADMIN_EMAIL="admin@appointly.dev"
# SUPER_ADMIN_PASSWORD="ChangeMe123"
